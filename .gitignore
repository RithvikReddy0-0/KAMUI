# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ── ML / Model artefacts ─────────────────────────────────────────────────────
# Checkpoints (large binary files — use Git LFS or external storage)
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Tokeniser artefacts trained from data
*.model
*.vocab

# ── Data ─────────────────────────────────────────────────────────────────────
# Raw data is never committed — see data/README.md for download instructions
data/*.txt
data/*.bin
data/*.json
data/*.jsonl
data/*.parquet
data/*.arrow
data/*.csv
!data/README.md
!data/download_*.sh

# ── Research artefacts ───────────────────────────────────────────────────────
# Large figures — commit only final publication-ready figures
research/figures/*.png
research/figures/*.pdf
# Keep SVG (version-controllable vector graphics)
!research/figures/*.svg

# ── Documentation build ──────────────────────────────────────────────────────
site/
docs/_build/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
wandb/
runs/
tensorboard_logs/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
